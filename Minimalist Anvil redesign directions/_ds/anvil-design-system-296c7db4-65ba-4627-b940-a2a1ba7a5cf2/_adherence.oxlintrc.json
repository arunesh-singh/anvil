{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/feedback/**",
              "components/icons/**",
              "components/inputs/**",
              "components/navigation/**",
              "components/surfaces/**",
              "ui_kits/anvil-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|JetBrains Mono|Material Icons))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, JetBrains Mono, Material Icons."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|actions|style|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: icon, children, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|trailingIcon|children|disabled|fullWidth|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, trailingIcon, children, disabled, fullWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|neutral|tonal|text)$/]",
        "message": "<Button> variant must be one of 'filled' | 'neutral' | 'tonal' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:action|compact)$/]",
        "message": "<Button> size must be one of 'action' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|interactive|radius|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: level, interactive, radius, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CircularProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|stroke|color|style|key|ref|className|style|children)$/]",
        "message": "<CircularProgress> doesn't accept that prop. Declared props: size, stroke, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|filled|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, filled."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|selected|disabled|size|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, selected, disabled, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|box|glyph|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconChip> doesn't accept that prop. Declared props: icon, tone, box, glyph, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|neutral|high|solid)$/]",
        "message": "<IconChip> tone must be one of 'accent' | 'neutral' | 'high' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|style|key|ref|className|style|children)$/]",
        "message": "<InfoCard> doesn't accept that prop. Declared props: icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinearProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|style|key|ref|className|style|children)$/]",
        "message": "<LinearProgress> doesn't accept that prop. Declared props: value, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:leadingIcon|title|subtitle|trailing|lines|dense|style|key|ref|className|style|children)$/]",
        "message": "<ListTile> doesn't accept that prop. Declared props: leadingIcon, title, subtitle, trailing, lines, dense, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|stroke|centerLabel|subLabel|style|key|ref|className|style|children)$/]",
        "message": "<ProgressRing> doesn't accept that prop. Declared props: value, size, stroke, centerLabel, subLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|selected|onSelect|disabled|style|key|ref|className|style|children)$/]",
        "message": "<RadioTile> doesn't accept that prop. Declared props: label, value, selected, onSelect, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionEyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|tone|style|key|ref|className|style|children)$/]",
        "message": "<SectionEyebrow> doesn't accept that prop. Declared props: children, icon, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionEyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|accent)$/]",
        "message": "<SectionEyebrow> tone must be one of 'muted' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Snackbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|action|onAction|style|key|ref|className|style|children)$/]",
        "message": "<Snackbar> doesn't accept that prop. Declared props: children, action, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepperField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|min|max|step|unit|helperText|onChange|style|key|ref|className|style|children)$/]",
        "message": "<StepperField> doesn't accept that prop. Declared props: label, value, min, max, step, unit, helperText, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|value|prefixIcon|multiline|rows|error|helperText|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, hint, value, prefixIcon, multiline, rows, error, helperText, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|leading|title|subtitle|mono|trailing|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ToolRow> doesn't accept that prop. Declared props: icon, leading, title, subtitle, mono, trailing, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ToolTile> doesn't accept that prop. Declared props: icon, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopAppBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onBack|actions|style|key|ref|className|style|children)$/]",
        "message": "<TopAppBar> doesn't accept that prop. Declared props: title, onBack, actions, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
